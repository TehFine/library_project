#!/usr/bin/env python3
import os
import sys

def get_all_extensions(root_folder):
    extensions = set()
    for dirpath, _, filenames in os.walk(root_folder):
        for fname in filenames:
            _, ext = os.path.splitext(fname)
            if ext:                     # có đuôi mở rộng
                extensions.add(ext.lower())   # không phân biệt hoa/thường
            else:
                extensions.add("[không có đuôi]")
    return sorted(extensions)

if __name__ == "__main__":
    # Lấy đường dẫn từ tham số dòng lệnh, mặc định là thư mục hiện tại
    folder = sys.argv[1] if len(sys.argv) > 1 else "."
    if not os.path.isdir(folder):
        print(f"Lỗi: '{folder}' không phải là thư mục hợp lệ.")
        sys.exit(1)

    all_exts = get_all_extensions(folder)
    print("Các đuôi file tìm thấy:")
    for ext in all_exts:
        print(ext)